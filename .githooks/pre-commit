#
# Pre-commit guard against committing personal data, generated exports, and
# secrets. Enable it with:
#
#   git config core.hooksPath .githooks
#
# The denylist (town, real names, home coordinates) is read at runtime from
# outside the repo, so it never leaks. See photosmeta/leaks.py for details.

set -eu

root="$(git rev-parse --show-toplevel)"
cd "$root"

# Refuse commits made directly on the main branch (override: ALLOW_MAIN_COMMIT=1).
branch="$(git symbolic-ref --short -q HEAD || true)"
default="$(git symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)"
if [ -z "${ALLOW_MAIN_COMMIT:-}" ] && [ -n "$branch" ]; then
    if [ "$branch" = main ] || [ "$branch" = master ] ||
        { [ -n "$default" ] && [ "$branch" = "$default" ]; }; then
        echo "pre-commit: refusing to commit directly to '$branch'. Branch first: git switch -c <name>" >&2
        exit 1
    fi
fi

python="python3"
if [ -x ".venv/bin/python" ]; then
    python=".venv/bin/python"
fi

"$python" -m photosmeta.leaks --staged

if command -v gitleaks >/dev/null 2>&1; then
    # gitleaks 8.19 replaced `protect` with `git`; pick one so a finding is
    # reported once instead of re-running the scan.
    if gitleaks help 2>/dev/null | grep -q '^  git '; then
        gitleaks git --staged --redact --no-banner
    else
        gitleaks protect --staged --redact --no-banner
    fi
else
    echo "WARNING: gitleaks is not installed; skipping the local secret scan." >&2
    echo "         CI's secret-scan job is the backstop. Install: brew install gitleaks" >&2
fi
